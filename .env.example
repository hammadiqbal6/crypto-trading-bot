# =============================================================================
# crypto-trading-bot — environment template
# Copy to .env and fill in values. NEVER commit .env.
# Store production secrets in GitHub Actions secrets or server env vars.
# =============================================================================

# --- Mode ---
# paper  = local freqtrade dry_run (DEFAULT) — no exchange orders
# demo   = real orders on Bybit Demo Trading or Binance Spot Testnet (dry_run=false)
# live   = mainnet — ONLY with LIVE_TRADING=true + LIVE_TRADING_CONFIRM below
TRADING_MODE=paper
LIVE_TRADING=false
LIVE_TRADING_CONFIRM=

# --- Exchange: Bybit Demo (default host when BYBIT_DEMO=true, Pakistan-friendly) ---
# Signup: https://www.bybit.com/ → Demo Trading → API Management
# Docs: https://bybit-exchange.github.io/docs/v5/demo
# Uses ccxt enable_demo_trading / freqtrade exchange.demo_trading (NOT hostname=api-demo...).
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_DEMO=true

# --- Exchange alternative: Binance Spot Testnet ---
# Signup: https://testnet.binance.vision (NOT licensed in Pakistan for live)
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=
EXCHANGE_NAME=bybit  # bybit | binance

# To place demo/testnet orders (not local paper):
#   TRADING_MODE=demo
#   BYBIT_DEMO=true   # required for Bybit
#   # fill BYBIT_API_KEY / BYBIT_API_SECRET (Demo Trading keys)
# Then: crypto-bot export-freqtrade-config && freqtrade trade -c config/freqtrade/config.json
# Never set dry_run=false against mainnet without the live lock.

# --- Optional: CoinGecko Demo (market metadata) ---
# Signup: https://www.coingecko.com/en/api
COINGECKO_API_KEY=

# --- News: GDELT needs NO key. RSS needs NO key. ---
# Optional Reddit (free non-commercial; access may close — see research)
# Signup: https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=crypto-trading-bot/0.1 by yourusername
NEWS_ENABLE_REDDIT=false

# --- Sentiment LLM (optional; FinBERT local is default fallback, no key) ---
# Groq free tier (default LLM): https://console.groq.com
# Limits ~30 rpm / 14,400/day — Llama 3.1 8B
LLM_PROVIDER=groq  # groq | ollama | openai | none
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_RATE_LIMIT_RPM=25
SENTIMENT_CACHE_TTL_HOURS=24

# --- Dashboard ---
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080
DASHBOARD_SECRET_KEY=change-me-to-a-long-random-string

# --- Risk defaults (override in config/settings.yaml too) ---
MAX_OPEN_TRADES=3
STAKE_CURRENCY=USDT
DRY_RUN_WALLET=10000
MAX_DAILY_LOSS_PCT=3.0
MAX_DRAWDOWN_PCT=15.0
STOPLOSS_PCT=-0.05

# --- FreqAI (optional gradient boosting) ---
FREQAI_ENABLED=false

# --- Carry module (optional, OFF by default) ---
CARRY_ENABLED=false

# --- Logging ---
LOG_LEVEL=INFO
LOG_JSON=false

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///./user_data/crypto_bot.db
