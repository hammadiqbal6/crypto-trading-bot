  "strategy": "VolatilityMomentumStrategy",
  "user_data_dir": "user_data",
  "crypto_bot": {
    "sentiment_block_threshold": -0.55,
    "sentiment_sizeup_threshold": 0.45,
    "sentiment_sizeup_factor": 1.15,
    "volatility_target_annual": 0.2,
    "freqai_enabled": false,
    "carry_enabled": false
