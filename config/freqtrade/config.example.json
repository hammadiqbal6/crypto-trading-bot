{
  "max_open_trades": 3,
  "stake_currency": "USDT",
  "dry_run": true,
  "dry_run_wallet": 10000,
  "trading_mode": "spot",
  "exchange": {
    "name": "bybit",
    "key": "",
    "secret": "",
    "ccxt_config": {
      "enableRateLimit": true,
      "hostname": "api-demo.bybit.com",
